# Platform URLs
# Production canonical domain (also aliased on Vercel: cohorts.ludwitt.com, site-nine-rouge-68.vercel.app, …)
NEXT_PUBLIC_SITE_URL=https://cohorts.algorithmacy.org
# Optional: hostname shown in legal copy (defaults to program name on *.vercel.app)
# NEXT_PUBLIC_SITE_DISPLAY_HOST=cohort.hult.edu
NEXT_PUBLIC_COHORT_REPO=rogerSuperBuilderAlpha/hult-cohort-program
NEXT_PUBLIC_COHORT_ORG=rogerSuperBuilderAlpha
# Active cohort — Summer 2026 pilot (program begins July 9, 2026)
COHORT_ID=summer26
# Next cohort interest list (Fall 2026 — applications not open yet)
NEXT_PUBLIC_NEXT_COHORT_ID=fall26
# Comma-separated cohort ids scanned for /history (defaults to COHORT_ID)
# KNOWN_COHORT_IDS=summer26,fall26
# Accept PRs merged to main during branch migration (default false in prod)
# ALLOW_LEGACY_MAIN_SUBMISSIONS=true
# Required in production for /api/cron/warm-contest (Vercel Cron sends Bearer token)
# CRON_SECRET=

# Public Firebase client config (safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only — never NEXT_PUBLIC_*
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# Or inline JSON for Vercel:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# GitHub — server-only unless noted
# GITHUB_TOKEN required in production (contest state: PRs + review issues)
GITHUB_TOKEN=
# E2E/staff: bypass review-week calendar gates (remove after testing)
# REVIEW_WINDOW_OVERRIDE=open
# GITHUB_WEBHOOK_SECRET must match the org/repo webhook (pull_request + issues events)
GITHUB_WEBHOOK_SECRET=
# HMAC secret for email unsubscribe links (required in production)
UNSUBSCRIBE_SECRET=
# Salt for research survey participant ids (required in production)
RESEARCH_HASH_SALT=

# Transactional email (same env names as pitch-rise / Ludwitt stack)
EMAIL_PROVIDER=mailgun
EMAIL_API_KEY=
EMAIL_DOMAIN=
EMAIL_FROM=cohort@ludwitt.com
EMAIL_FROM_NAME=Hult Cohort
# EU Mailgun accounts: EMAIL_API_BASE=https://api.eu.mailgun.net/v3

NEXT_PUBLIC_TAKE_HOME_REPO_URL=
