# Platform URLs
# Production canonical domain (also aliased on Vercel: cohorts.ludwitt.com, site-nine-rouge-68.vercel.app, …)
NEXT_PUBLIC_SITE_URL=https://cohorts.algorithmacy.org
# Optional: hostname shown in legal copy (defaults to program name on *.vercel.app)
# NEXT_PUBLIC_SITE_DISPLAY_HOST=cohort.hult.edu
# Canonical host for /apply OAuth redirect (middleware; defaults to cohorts.algorithmacy.org)
# NEXT_PUBLIC_CANONICAL_APPLY_HOST=cohorts.algorithmacy.org
NEXT_PUBLIC_COHORT_REPO=rogerSuperBuilderAlpha/hult-cohort-program
NEXT_PUBLIC_COHORT_ORG=rogerSuperBuilderAlpha
# Active cohort — Summer 2026 pilot (program begins July 9, 2026)
COHORT_ID=summer26
# Next cohort interest list (Fall 2026 — applications not open yet)
NEXT_PUBLIC_NEXT_COHORT_ID=fall26
# Comma-separated cohort ids scanned for /history (defaults to COHORT_ID)
# KNOWN_COHORT_IDS=summer26,fall26
# Accept PRs merged to main during branch migration (default false in prod)
# ALLOW_LEGACY_MAIN_SUBMISSIONS=true

# Required in production for /api/cron/warm-contest (Vercel Cron sends Bearer token).
# Unset → 503 in production. Set in Vercel project env for Production + Preview.
CRON_SECRET=

# Public Firebase client config (safe to expose in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Firebase web fields
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only — never NEXT_PUBLIC_*
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# Or inline JSON for Vercel:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# GitHub — server-only
# GITHUB_TOKEN required in production (contest state: PRs + review issue Search API)
GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET must match the org/repo webhook (pull_request + issues events)
GITHUB_WEBHOOK_SECRET=
# HMAC secret for email unsubscribe links (required in production)
UNSUBSCRIBE_SECRET=
# Salt for research survey participant ids (required in production)
RESEARCH_HASH_SALT=

# E2E/staff only — never leave set in production long-term
# REVIEW_WINDOW_OVERRIDE=open
# SURVEY_WINDOW_OVERRIDE=open

# Transactional email (Mailgun — skips gracefully when unset)
EMAIL_PROVIDER=mailgun
EMAIL_API_KEY=
EMAIL_DOMAIN=
EMAIL_FROM=cohort@ludwitt.com
EMAIL_FROM_NAME=Hult Cohort
# EU Mailgun accounts: EMAIL_API_BASE=https://api.eu.mailgun.net/v3
# Staff notify on new applications
# ADMISSIONS_NOTIFY_EMAIL=cohort@hult.edu

# Staff email blasts (scripts/blast.mjs) — see scripts/BLAST.md
# EMAIL_PHYSICAL_ADDRESS=…   # CAN-SPAM footer (required for real blasts)
# APOLLO_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SES_REGION=us-east-1
# SES_CONFIGURATION_SET=

# Research survey IRB disclosures (optional overrides)
# NEXT_PUBLIC_RESEARCH_PI_NAME=
# NEXT_PUBLIC_RESEARCH_PI_EMAIL=
# NEXT_PUBLIC_RESEARCH_IRB_PROTOCOL=
# NEXT_PUBLIC_RESEARCH_IRB_CONTACT=

NEXT_PUBLIC_TAKE_HOME_REPO_URL=
