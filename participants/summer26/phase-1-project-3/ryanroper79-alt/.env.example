# Optional — /join form (Phase 4)
# GITHUB_TOKEN=              # PAT with issues:write — opens join requests as GitHub issues
# JOIN_GITHUB_REPO=          # owner/repo for issues (default: ryanroper79-alt/hult-cohort-program)
# JOIN_NOTIFY_EMAIL=         # included in issue body; fallback mailto when GITHUB_TOKEN unset

# Optional — /api/partner enquiry form + /api/verify live checks
# RESEND_API_KEY=            # Resend API key — email notification on partner enquiries
# PARTNER_NOTIFY_EMAIL=      # Inbox for partner enquiries (default: ryan@cealgreen.com)
# RESEND_FROM_EMAIL=         # Verified sender in Resend (default: onboarding@resend.dev)

# Optional — Calendly embed on /partners
# NEXT_PUBLIC_CALENDLY_URL=  # e.g. https://calendly.com/your-link/30min

# Optional — showcase RSVP + partner notify inbox
# PLACEMENT_LEAD_EMAIL=      # defaults to PARTNER_NOTIFY_EMAIL or ryan@cealgreen.com

# Optional — site metadata
# NEXT_PUBLIC_SITE_URL=      # Production URL (default: https://cealgreen-projects.vercel.app)
