# Ludwitt OAuth (server-side only — never expose to the browser)
LUDWITT_CLIENT_SECRET=

# Encrypt Ludwitt session cookies (use a long random string)
SESSION_SECRET=

# Optional override; default is https://localhost:3000/auth/callback
# LUDWITT_REDIRECT_URI=https://localhost:3000/auth/callback
# VITE_LUDWITT_REDIRECT_URI=https://localhost:3000/auth/callback
