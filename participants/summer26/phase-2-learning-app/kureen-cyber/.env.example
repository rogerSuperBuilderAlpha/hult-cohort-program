# InterviewForge — Ludwitt Hosted-storage tier (35% engineer share)
#
# DEMO_MODE=true  → local practice without Ludwitt
# DEMO_MODE=false → OAuth + hosted-data + credit-spend AI

DEMO_MODE=false

# From https://pitchrise.ludwitt.com/developers/apps/new (or app settings)
LUDWITT_CLIENT_ID=le_42901d22b6f990da1324b3
LUDWITT_CLIENT_SECRET=
LUDWITT_BASE_URL=https://pitchrise.ludwitt.com
LUDWITT_SCOPES=profile credits:read credits:spend data:read data:write

# Must exactly match a redirect URI registered on the Ludwitt app
# Production: https://interview-forge-rosy.vercel.app/api/auth/callback
# Local:      http://localhost:3000/api/auth/callback
LUDWITT_REDIRECT_URI=http://localhost:3000/api/auth/callback
LUDWITT_AI_MODEL=claude-sonnet-4-6

# Collections declared at registration:
#   Events   — indexed: eventType, createdAt, sessionId
#   sessions — indexed: status, createdAt, track

SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
COOKIE_SECURE=false
