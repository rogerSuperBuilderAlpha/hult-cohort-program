# Ludwitt/Hult platform credentials (from POST /v1/developer/apps)
LUDWITT_APP_ID=
LUDWITT_API_KEY=
LUDWITT_JWT_SECRET=

# Platform API base URL
# Local dev: http://localhost:4000/v1
# Production: https://api.ludwitt.hult/v1
LUDWITT_API_BASE_URL=http://localhost:4000/v1

# Developer key used only by scripts/register-app.mts
LUDWITT_DEVELOPER_KEY=prod_key_demo

# Public production URL (for registration script)
APP_PRODUCTION_URL=https://your-app.vercel.app
