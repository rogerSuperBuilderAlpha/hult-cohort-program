# NextAuth.js (GitHub OAuth)
# Create OAuth App at https://github.com/settings/developers
# Callback URL: https://your-app.vercel.app/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-app.vercel.app

# Database (Turso for production)
# 1. Install Turso CLI: npm i -g turso
# 2. Create DB: turso db create cursor-boston-showcase
# 3. Get URL: turso db show cursor-boston-showcase --url
# 4. Get token: turso db tokens create cursor-boston-showcase
DATABASE_URL="file:./dev.db"
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-token"

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
