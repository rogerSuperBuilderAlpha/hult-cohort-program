# Copy to .env / .env.local
AUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_PM_URL="https://pilot-hult-pm.vercel.app"

# Optional: public app URL used to build the GitHub OAuth callback when set
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth (Login with GitHub). Leave unset to hide/disable the button.
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL (production):
#   https://pilot-hult-comms.vercel.app/api/auth/github/callback
# Local callback (add a second OAuth App or update Hompage/callback for local):
#   http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional override (defaults to NEXT_PUBLIC_APP_URL or request origin + /api/auth/github/callback)
# GITHUB_CALLBACK_URL="https://pilot-hult-comms.vercel.app/api/auth/github/callback"
