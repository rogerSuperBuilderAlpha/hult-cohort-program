# =============================================================================
# Conexus — environment template (PRD §6)
# Copy to .env.local and fill in real values. Never commit secrets.
#   cp .env.example .env.local
# =============================================================================

# --- Supabase (required for local + production) ---
# Phase B: one shared project doubles as local/dev and production.
# Seed intentionally requires CLI `--confirm` (not an env gate): npm run db:seed -- --confirm
# Project URL from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key (safe for browser; still do not commit real values)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key — server-only (admin scripts, webhooks). Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection URI — required to run `npm run db:apply` (DDL).
# Dashboard → Project Settings → Database → Connection string → URI (Session pooler recommended).
# Example: postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- App URLs ---
# Local: http://localhost:3000  |  Production: set in Phase B (Vercel HTTPS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (Step 3+) ---
# Google OAuth is configured in the Supabase dashboard (Auth → Providers → Google).
# Authorized redirect URI for Google Cloud: {SUPABASE_URL}/auth/v1/callback
# Supabase Auth URL config should allow: {NEXT_PUBLIC_APP_URL}/**
#
# Optional: comma-separated emails allowed when not yet on roster CSV.
# AUTH_ALLOWLIST_FALLBACK=

# Local demo login (password) without Google — keep true on localhost only.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
DEV_ADMIN_EMAIL=admin@conexus.local
DEV_ADMIN_PASSWORD=ConexusSeed!2026

# --- Forth integration (Steps 8–9; fixture-backed until §7.0 contract is live) ---
# Forth production app (deep links). Do not invent alternate URLs.
NEXT_PUBLIC_FORTH_BASE_URL=https://forth-bice.vercel.app

# Shared bearer key for Forth read/create endpoints (server-only), when contract lands.
# FORTH_API_KEY=

# HMAC secret for POST /api/webhooks/forth (server-only).
# FORTH_WEBHOOK_SECRET=

# Use fixtures instead of live Forth HTTP (default true until contract is live).
FORTH_USE_FIXTURES=true

# --- Optional: cron / polling (Step 8) ---
# Protects ticket poller route if invoked externally.
# CRON_SECRET=
