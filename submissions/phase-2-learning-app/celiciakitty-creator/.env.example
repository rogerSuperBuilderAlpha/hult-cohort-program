# Ludwitt OAuth (server-side only — never expose to the browser)
LUDWITT_CLIENT_ID=
LUDWITT_CLIENT_SECRET=
LUDWITT_REDIRECT_URI=http://localhost:3000/auth/callback

# Encrypts the HttpOnly session cookie (min 32 characters)
LUDWITT_SESSION_SECRET=

# Public site URL for metadata and Open Graph (no trailing slash)
# Local: http://localhost:3000
# Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=
