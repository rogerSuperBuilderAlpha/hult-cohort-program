# From Ludwitt/Hult developer registration (https://ludwitt.com/developers)
LUDWITT_APP_ID=
LUDWITT_API_KEY=
LUDWITT_JWT_SECRET=

# Events API base
# Production: https://api.ludwitt.hult/v1
# Sandbox (docs): https://sandbox.api.ludwitt.hult/v1
# Local API package: http://localhost:4000/v1
LUDWITT_API_BASE_URL=https://api.ludwitt.hult/v1

# Public site URL (no trailing slash) — used as launch_url base
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: values used by scripts/mint-launch-token.mjs
LUDWITT_TEST_USER_ID=
LUDWITT_TEST_EMAIL=learner@example.com

# Local walks without a Ludwitt token. Set false on production Vercel.
ALLOW_DEV_BYPASS=true
