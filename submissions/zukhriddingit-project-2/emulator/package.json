{
  "name": "relay65-firestore-emulator",
  "private": true,
  "type": "module",
  "description": "Firestore Security Rules smoke tests for Relay 65 channel visibility.",
  "scripts": {
    "test": "node --test channel-rules-smoke.mjs",
    "test:emulator": "firebase --config ../firebase.json --project demo-relay65-channel-rules emulators:exec --only firestore \"npm test\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.16.0",
    "firebase-tools": "15.24.0"
  }
}
